# ══════════════════════════════════════════════════════════════════
#  VCD → VCD Migration Environment File
#  Location : /home/ubuntu/scripts/.vcd2vcd.env
#  Usage    : source'd automatically by vcd2vcd_multipart.sh
#
#  Confirmed working 2026-06-19:
#    Auth endpoint : POST /cloudapi/1.0.0/sessions (Basic -u + JSON body)
#    Token header  : X-VMWARE-VCLOUD-ACCESS-TOKEN  (Bearer JWT)
#    API version   : 39.1  (36.3 returns 406 on this VCD)
#    Catalog lookup: GET /api/query?type=catalog&filter=name==<name>
#    XML parsing   : grep -oP  (xmllint fails on VCD namespace XML)
# ══════════════════════════════════════════════════════════════════

# ── Source VCD (Broadcom) ─────────────────────────────────────────
export SRC_VCD_HOST=lvn-cm3-vcd2.broadcom.com
export SRC_VCD_ORG=lvn3-vcd2-eduprod-r
export SRC_VCD_CATALOG=Ascend-Base-Catalog
export SRC_VCD_USERNAME=check1
export SRC_VCD_PASSWORD='VMware123!'

# ── Destination VCD (Ascend Cloud) ───────────────────────────────
export DST_VCD_HOST=vcd-acs-vedp-ldn.ascendcloudsolutions.com
export DST_VCD_ORG=vsan-prd-01-wkld
export DST_VCD_CATALOG=VKS3
export DST_VCD_USERNAME=template_manager
export DST_VCD_PASSWORD='Acs123'

# ── API & auth (confirmed 2026-06-19) ────────────────────────────
# Ascend VCD supported versions: 39.1, 39.0, 38.1, 38.0, 37.x
# /api/sessions (old Basic auth) returns 405 on VCD 39.x
# Must use /cloudapi/1.0.0/sessions with Basic -u + JSON body
export VCD_API_VERSION=39.1

# ── Staging ───────────────────────────────────────────────────────
export STAGING_DIR=/staging
export LOG_DIR=/staging/logs

# ── Optional: rsync to remote staging host ────────────────────────
# Leave blank if export and upload run on the same host.
# Set to user@host:/path to rsync the OVF package to a remote box.
export REMOTE_STAGING=
export RSYNC_BW_LIMIT=0        # KB/s throttle; 0 = unlimited

# ── Download tuning ───────────────────────────────────────────────
# DL_FILE_PARALLEL_JOBS : files downloaded in parallel (sliding window)
# DL_PARALLEL_JOBS      : parallel Range-GET chunks per file
export DL_FILE_PARALLEL_JOBS=5
export DL_PARALLEL_JOBS=8

# ── Upload tuning ─────────────────────────────────────────────────
# CHUNK_SIZE_MB       : size of each Content-Range PUT to VCD REST API
#                       Logs show VCD's staging buffer saturates at ~256 MB under load;
#                       sending 512 MB chunks caused mid-chunk HTTP 500 (exactly at 256 MB).
#                       Keep at 256 MB unless VCD capacity is confirmed to handle more.
# UL_PARALLEL_JOBS    : concurrent file uploads (sliding window)
#                       VCD returns HTTP 500 under heavy concurrent load;
#                       4 parallel × 512 MB = 2 GB staged simultaneously caused mass stuck.
#                       Keep at 2 (2 × 256 MB = 512 MB staged) unless VCD confirms more.
# UPLOAD_RETRY_MAX    : retries per failed chunk
# UPLOAD_RETRY_DELAY  : initial back-off in seconds (doubles each retry)
#                       10 retries at 60s initial = up to ~2 h max wait per chunk
export CHUNK_SIZE_MB=256
export UL_PARALLEL_JOBS=6
export UPLOAD_RETRY_MAX=10
export UPLOAD_RETRY_DELAY=60
